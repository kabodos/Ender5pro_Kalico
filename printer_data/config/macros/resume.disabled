######################################################################
# Macro resume
######################################################################


#[gcode_macro SEGUIR]
#description: Continua con el trabajo actual de impresión, para Klipper screen
#gcode: 
#  RESUME

#[gcode_macro RESUME]
#description: Continua con el trabajo actual de impresión, si fué parado por PAUSE.
#rename_existing: RESUME_BASE
#gcode:
#  M118 Recibida orden de continuar
#  M117 Recibida orden de continuar
#  ##### read E from pause macro #####
#  {% set E = printer["gcode_macro PAUSE"].extrude|float %}
#  #### get VELOCITY parameter if specified ####
#  {% if 'VELOCITY' in params|upper %}
#    {% set get_params = ('VELOCITY=' + params.VELOCITY)  %}
#  {%else %}
#    {% set get_params = "" %}
#  {% endif %}
#  ##### end of definitions #####
#  {% if printer.extruder.can_extrude|lower == 'true' %}
#    G91
#    G1 E{E} F2100
#  {% else %}
#    {action_respond_info("La extrusora no está lo suficientemente caliente")}
#    #_LED_AZUL
#    Pausa #Beep2
#  {% endif %}  
#  RESUME_BASE {get_params}
#  LUCES_IMPRIMIENDO

[gcode_macro RESUME]
description: Continuar impresion
rename_existing: RESUME_BASE

gcode:

    M117 Preparando impresion...

    {% set E = printer["gcode_macro PAUSE"].extrude|float %}

    {% if 'VELOCITY' in params|upper %}
        {% set get_params=('VELOCITY=' + params.VELOCITY) %}
    {% else %}
        {% set get_params="" %}
    {% endif %}

    {% if printer.extruder.can_extrude|lower == 'true' %}

        G91

        ##################################
        ## SMART PRIME
        ##################################

        G1 E{E} F900

        ##################################
        ## ESPERA
        ##################################

        G4 P150

        ##################################
        ## ANTI STRINGING
        ##################################

        G1 E-0.15 F2400

        ##################################
        ## MINI WIPE
        ##################################

        G1 X1.5 E0.05 F1200
        G1 X-1.5 F6000

        G90

    {% else %}

        {action_respond_info("Extrusor frio")}

    {% endif %}

    M117 Reanudando impresion...

    RESUME_BASE {get_params}

    LUCES_IMPRIMIENDO